# Build context for the root Dockerfile / electron app. Skip everything the
# build regenerates from source and anything that pins host-local state.

# heavy / generated — regenerated by pnpm/vite inside the builder
node_modules
packages/*/node_modules
**/node_modules
**/dist
**/.turbo
**/.vite
dist

# electron build outputs (regenerated by the electron build)
packages/electron/out
packages/electron/resources/node
packages/electron/resources/icons
packages/electron/resources/server
packages/electron/.vite

# git internals — not needed to build (git is installed in the image for
# runtime worktree support; version stamping does not call git at build time)
.git
.gitignore
.gitattributes

# repo-local pi/openspec state — not needed to build. Exclude .pi wholesale but
# keep the skill scripts: they are part of the module graph the dead-code
# oracle analyses (knip.json roots `.pi/skills/**/scripts/*.ts`). Everything
# else under .pi stays out — notably settings.json, which pins a HOST absolute
# path for its extension packages and would break container sessions.
.pi
!.pi/skills
openspec

# local tooling / editor / OS junk
.idea
.vscode
*.log
npm-debug.log*
coverage
*.swp
*.swo
*~
.DS_Store

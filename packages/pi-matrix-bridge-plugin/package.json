{
  "name": "@blackbelt-technology/pi-matrix-bridge-plugin",
  "version": "0.1.0",
  "description": "Pi Matrix Bridge — pi-dashboard plugin",
  "type": "module",
  "private": false,
  "exports": {
      "./client": "./src/client.tsx",
      "./server": "./src/server/index.ts"
  },
  "files": [
    "src/",
    "configSchema.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.7.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "ajv": "^8.0.0",
    "fastify": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  },
  "pi-dashboard-plugin": {
    "id": "pi-matrix-bridge",
    "displayName": "Pi Matrix Bridge",
    "priority": 100,
    "requiredApi": "^0.7.0",
    "client": "./src/client.tsx",
    "server": "./src/server/index.ts",
    "configSchema": "./configSchema.json",
    "claims": [
          {
                "slot": "settings-section",
                "component": "Settings",
                "config": {
                      "tab": "general"
                }
          }
    ]
  }
}
